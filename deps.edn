{:paths   ["src"]
 :deps    {org.clojure/clojure                 {:mvn/version "1.13.0-alpha11"}
           org.clojure/data.json               {:mvn/version "2.5.2"}
           camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
           hato/hato                           {:mvn/version "1.0.0"}}
 :aliases {:dev  {:extra-paths ["dev"]}
           :test {:extra-paths ["test/src"]
                  :extra-deps  {nubank/matcher-combinators {:mvn/version "3.10.0"}}}
           :test-runner
           {:extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
            :main-opts  ["-m" "cognitect.test-runner"]
            :exec-fn    cognitect.test-runner.api/test}
           :cloverage
           {:extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
            :main-opts  ["-m" "cloverage.coverage"
                         "-p" "src"
                         "-s" "test/src"
                         "--codecov"]}
           :build
           {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                         slipset/deps-deploy           {:mvn/version "0.2.5"}}
            :ns-default build}}}
